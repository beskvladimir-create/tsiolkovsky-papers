# Сканы: 18 ГБ сырья, в git не место.
# (исключаем содержимое, а не саму папку: иначе git не заглянет внутрь
#  и отрицание ниже не сработает)
data/*
# Транскрипции держим отдельно до выпуска корпуса вместе со статьёй.
!data/transcripts/

# Логи прогонов
*.log

# Состояние процессов
.full_pid
.dl_pid
.orch_pid
.keeper_pid

# Бэкапы каталога
catalog.csv.bak

# macOS
.DS_Store

# Производные метрики: пересчитываются classify_pages.py за 100 секунд
page_metrics.csv

# Кэш питона
__pycache__/
*.pyc

# Разовые производные файлы
remap.json
