# Сканы: 13 ГБ сырья, в git не место. Бэкап отдельно.
# (исключаем содержимое, а не саму папку: иначе git не заглянет внутрь
#  и отрицание ниже не сработает)
data/*
# Транскрипции версионируем: текст, мало весит, ядро проекта.
# В публичный репозиторий не пойдут, для них отдельный приватный remote.
!data/transcripts/

# Логи прогонов
*.log

# Состояние процессов
.full_pid
.dl_pid
.orch_pid

# Бэкапы каталога
catalog.csv.bak

# macOS
.DS_Store

# Производные метрики: пересчитываются classify_pages.py за 100 секунд
page_metrics.csv

# Кэш питона
__pycache__/
*.pyc

# Состояние процессов
.keeper_pid
